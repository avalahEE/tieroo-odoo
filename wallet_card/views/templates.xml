<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tieroo_return_page" name="Tieroo: back from the payment">
        <html t-att-lang="(env.lang or 'en_US').replace('_', '-')">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex"/>
                <meta t-if="refresh" http-equiv="refresh" t-att-content="'3; url=%s' % refresh"/>
                <title>Tieroo</title>
                <style>
                    body { margin: 0; font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #18181b; background: #f4f4f5; }
                    main { max-width: 480px; margin: 64px auto; padding: 28px 24px; background: #fff; border-radius: 16px; box-shadow: 0 1px 2px rgba(0,0,0,.06); }
                    h1 { font-size: 22px; line-height: 1.25; margin: 0 0 12px; }
                    p { margin: 0 0 16px; color: #3f3f46; }
                    .err { background: #fef2f2; color: #991b1b; border-radius: 10px; padding: 10px 12px; }
                    a.btn { display: inline-block; margin: 8px 8px 0 0; padding: 12px 18px; border-radius: 10px; background: #18181b; color: #fff; font-weight: 600; text-decoration: none; }
                    a.btn.alt { background: #e4e4e7; color: #18181b; }
                </style>
            </head>
            <body>
                <main>
                    <t t-if="error">
                        <h1>Connecting to Tieroo did not work</h1>
                        <p class="err" role="alert" t-out="error"/>
                        <a class="btn" t-att-href="settings">Back to Settings</a>
                    </t>
                    <t t-else="">
                        <h1>Waiting for the payment confirmation…</h1>
                        <p>Stripe has not confirmed the card yet. This usually takes a few seconds.</p>
                        <p t-if="refresh">This page checks again by itself.</p>
                        <t t-else="">
                            <p>It is taking longer than usual. Check again in a moment.</p>
                            <a class="btn" t-att-href="retry">Check again</a>
                            <a class="btn alt" t-att-href="settings">Back to Settings</a>
                        </t>
                    </t>
                </main>
            </body>
        </html>
    </template>
</odoo>
