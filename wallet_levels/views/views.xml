<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wallet_level_list" model="ir.ui.view">
        <field name="name">wallet.level.list</field>
        <field name="model">wallet.level</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <header>
                    <button name="action_recompute_all" type="object" string="Recalculate all customers" display="always" groups="point_of_sale.group_pos_manager"/>
                </header>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="customer_type"/>
                <field name="name"/>
                <field name="tag_id"/>
                <field name="min_spend"/>
                <field name="pricelist_id"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="wallet_level_action" model="ir.actions.act_window">
        <field name="name">Customer Levels</field>
        <field name="res_model">wallet.level</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your levels, e.g. Bronze from 0, Silver from 300, Gold from 1000.</p>
            <p>Each customer has a personal 12-month period from joining: they move up as soon as they spend enough, and the level is set again from that period's spend when it ends.</p>
            <p>B2B levels count the spend of the company and all its contacts; the level and pricelist go on the company.</p>
        </field>
    </record>

    <menuitem id="wallet_level_menu" name="Customer Levels" action="wallet_level_action"
              parent="point_of_sale.menu_point_config_product" sequence="50"/>

    <record id="res_partner_form_wallet_levels" model="ir.ui.view">
        <field name="name">res.partner.form.wallet.levels</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <separator string="Customer level"/>
                <field name="wallet_level_id" invisible="not wallet_level_id"/>
                <field name="wallet_period_spend" invisible="not wallet_period_end"/>
                <label for="wallet_period_end" string="Level period" invisible="not wallet_period_end"/>
                <div class="o_row" invisible="not wallet_period_end">
                    <field name="wallet_period_start"/>
                    <span>–</span>
                    <field name="wallet_period_end"/>
                </div>
                <field name="wallet_excluded" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_wallet_levels" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wallet.levels</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="wallet_card.res_config_settings_view_form_wallet_card"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='wallet_addons']" position="inside">
                <setting string="Customer levels" help="Levels from spend (Bronze, Silver, Gold…) that give pricelists, shown on the card. Point of Sale → Configuration → Customer Levels. A paid add-on: choose it in Plan and billing.">
                    <div class="mt16">
                        <field name="wallet_levels_auto_send" class="w-auto"/>
                        <label for="wallet_levels_auto_send" class="o_light_label"/>
                        <div class="text-muted">Create a card for every customer in the levels programme who has an email (for B2B: each contact person) and email it. Switching this on emails everyone who has no card yet.</div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
