#. module: tieroo
#. odoo-python
#: code:addons/tieroo/models.py:0
msgid "%s is already connected to Tieroo."
msgstr "%s on juba Tierooga ühendatud."

#. module: tieroo
#: model_terms:ir.ui.view,arch_db:tieroo.res_config_settings_view_form_wallet_card
msgid ", after that no new cards."
msgstr ", pärast seda uusi kaarte ei looda."

#. module: tieroo
#: model:mail.template,body_html:tieroo.mail_template_wallet_card
msgid ""
"<div>\n"
"    <t t-set=\"card\" t-value=\"object.sudo()\"/>\n"
"    <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"    <p>Add your loyalty card to your phone's wallet. Show the card at the checkout to use your customer benefits.</p>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <a t-if=\"card.apple_url\" t-att-href=\"card.apple_url\" style=\"display:inline-block;margin:0 8px 8px 0;background:#000000;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;\">Add to Apple Wallet</a>\n"
"        <a t-if=\"card.google_url\" t-att-href=\"card.google_url\" style=\"display:inline-block;margin:0 8px 8px 0;background:#1f1f1f;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;\">Add to Google Wallet</a>\n"
"        <a t-if=\"not card.apple_url and not card.google_url\" t-att-href=\"card.url\" style=\"display:inline-block;background:#0f172a;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;\">Open loyalty card</a>\n"
"    </p>\n"
"    <p style=\"color:#64748b;font-size:13px;\">The buttons work for 48 hours, until the card is on your phone.</p>\n"
"    <p>The card updates itself. The card and the link are personal, please do not share them.</p>\n"
"</div>\n"
"        "
msgstr ""
"<div>\n"
"    <t t-set=\"card\" t-value=\"object.sudo()\"/>\n"
"    <p>Tere <t t-out=\"object.partner_id.name\"/>,</p>\n"
"    <p>Lisa oma kliendikaart telefoni rahakotti. Näita kaarti kassas, et kasutada oma kliendisoodustusi.</p>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <a t-if=\"card.apple_url\" t-att-href=\"card.apple_url\" style=\"display:inline-block;margin:0 8px 8px 0;background:#000000;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;\">Lisa Apple Walletisse</a>\n"
"        <a t-if=\"card.google_url\" t-att-href=\"card.google_url\" style=\"display:inline-block;margin:0 8px 8px 0;background:#1f1f1f;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;\">Lisa Google Walletisse</a>\n"
"        <a t-if=\"not card.apple_url and not card.google_url\" t-att-href=\"card.url\" style=\"display:inline-block;background:#0f172a;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;\">Ava kliendikaart</a>\n"
"    </p>\n"
"    <p style=\"color:#64748b;font-size:13px;\">Nupud kehtivad 48 tundi ja kuni kaart on sinu telefonis.</p>\n"
"    <p>Kaart uueneb ise. Kaart ja link on isiklikud, palun ära jaga neid teistega.</p>\n"
"</div>\n"
"        "

