#. module: tieroo
#: model_terms:ir.ui.view,arch_db:tieroo.res_config_settings_view_form_wallet_card
msgid ""
"<span invisible=\"wallet_levels_missing != 'add'\">Customer Levels is installed in Odoo but not on your Tieroo plan: levels and pricelists work in Odoo, the cards do not show them. Add Customer Levels in Plan and billing.</span>\n"
"                                    <span invisible=\"wallet_levels_missing != 'upgrade'\">Customer Levels is installed in Odoo, but the free plan does not include it: levels and pricelists work in Odoo, the cards do not show them. Choose a paid plan with Customer Levels in Plan and billing.</span>"
msgstr ""
"<span invisible=\"wallet_levels_missing != 'add'\">Kliendi tasemed on Odoos paigaldatud, kuid pole sinu Tieroo paketis: tasemed ja hinnakirjad töötavad Odoos, kaardid neid ei näita. Lisa Kliendi tasemed lehel Pakett ja arveldus.</span>\n"
"                                    <span invisible=\"wallet_levels_missing != 'upgrade'\">Kliendi tasemed on Odoos paigaldatud, kuid tasuta pakett seda ei sisalda: tasemed ja hinnakirjad töötavad Odoos, kaardid neid ei näita. Vali lehel Pakett ja arveldus tasuline pakett koos Kliendi tasemetega.</span>"

