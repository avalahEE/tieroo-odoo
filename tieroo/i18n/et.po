#: code:addons/tieroo/models.py:0
msgid "%(count)s members would get a card, your Tieroo plan has room for %(room)s more. Choose a bigger plan first: Settings → Tieroo → Plan and billing."
msgstr "Kaardi saaks %(count)s liiget, sinu Tieroo paketis on ruumi veel %(room)s kaardile. Vali enne suurem pakett: Seaded → Tieroo → Pakett ja arveldus."

#. module: tieroo
#. odoo-python
#: code:addons/tieroo/models.py:0
msgid "%s is already connected to Tieroo."
msgstr "%s on juba Tierooga ühendatud."

#. module: tieroo
#: model_terms:ir.ui.view,arch_db:tieroo.res_config_settings_view_form_wallet_card
msgid ", after that no new cards."
msgstr ", pärast seda uusi kaarte ei looda."

#. module: tieroo
#: model:mail.template,body_html:tieroo.mail_template_join_confirm
msgid ""
"<div>\n"
"    <p>Hello <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p>Confirm your email address to join the loyalty programme of <t t-out=\"object.company_id.name\"/>. Then add the card to your phone.</p>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <a t-att-href=\"ctx.get('confirm_url')\" style=\"display:inline-block;background:#111111;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;font-weight:bold;\">Confirm and get the card</a>\n"
"    </p>\n"
"    <p style=\"color:#64748b;font-size:13px;\">The link works for 48 hours. Did not ask for this? Ignore this email: nothing happens.</p>\n"
"</div>\n"
"        "
msgstr ""
"<div>\n"
"    <p>Tere, <t t-out=\"object.name or ''\"/>!</p>\n"
"    <p>Kinnita oma e-posti aadress, et liituda ettevõtte <t t-out=\"object.company_id.name\"/> kliendiprogrammiga. Seejärel lisa kaart oma telefoni.</p>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <a t-att-href=\"ctx.get('confirm_url')\" style=\"display:inline-block;background:#111111;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;font-weight:bold;\">Kinnita ja saa kaart</a>\n"
"    </p>\n"
"    <p style=\"color:#64748b;font-size:13px;\">Link kehtib 48 tundi. Sa ei soovinud liituda? Jäta see kiri tähelepanuta: midagi ei juhtu.</p>\n"
"</div>\n"
"        "

#. module: tieroo
#: model:mail.template,body_html:tieroo.mail_template_wallet_card
msgid ""
"<div>\n"
"    <t t-set=\"card\" t-value=\"object.sudo()\"/>\n"
"    <p>Hello <t t-out=\"object.partner_id.name\"/>,</p>\n"
"    <p>Add your loyalty card to your phone's wallet. Show the card at the checkout to use your customer benefits.</p>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <t t-set=\"badge\" t-value=\"card.platform_url + '/badge/'\"/>\n"
"        <t t-set=\"lang\" t-value=\"'.png?lang=' + (object.partner_id.lang or 'en_US')\"/>\n"
"        <a t-if=\"card.apple_url\" t-att-href=\"card.apple_url\" style=\"display:inline-block;margin:0 8px 8px 0;text-decoration:none;\"><img t-att-src=\"badge + 'apple' + lang\" height=\"48\" alt=\"Add to Apple Wallet\" style=\"display:block;height:48px;width:auto;border:0;\"/></a>\n"
"        <a t-if=\"card.google_url\" t-att-href=\"card.google_url\" style=\"display:inline-block;margin:0 8px 8px 0;text-decoration:none;\"><img t-att-src=\"badge + 'google' + lang\" height=\"48\" alt=\"Add to Google Wallet\" style=\"display:block;height:48px;width:auto;max-width:100%;border:0;\"/></a>\n"
"        <a t-if=\"not card.apple_url and not card.google_url\" t-att-href=\"card.url\" style=\"display:inline-block;background:#0f172a;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;\">Open loyalty card</a>\n"
"    </p>\n"
"    <p style=\"color:#64748b;font-size:13px;\">The buttons work for 48 hours, until the card is on your phone.</p>\n"
"    <p>The card updates itself. The card and the link are personal, please do not share them.</p>\n"
"</div>\n"
"        "
msgstr ""
"<div>\n"
"    <t t-set=\"card\" t-value=\"object.sudo()\"/>\n"
"    <p>Tere <t t-out=\"object.partner_id.name\"/>,</p>\n"
"    <p>Lisa oma kliendikaart telefoni rahakotti. Näita kaarti kassas, et kasutada oma kliendisoodustusi.</p>\n"
"    <p style=\"margin: 24px 0;\">\n"
"        <t t-set=\"badge\" t-value=\"card.platform_url + '/badge/'\"/>\n"
"        <t t-set=\"lang\" t-value=\"'.png?lang=' + (object.partner_id.lang or 'en_US')\"/>\n"
"        <a t-if=\"card.apple_url\" t-att-href=\"card.apple_url\" style=\"display:inline-block;margin:0 8px 8px 0;text-decoration:none;\"><img t-att-src=\"badge + 'apple' + lang\" height=\"48\" alt=\"Lisa Apple Walletisse\" style=\"display:block;height:48px;width:auto;border:0;\"/></a>\n"
"        <a t-if=\"card.google_url\" t-att-href=\"card.google_url\" style=\"display:inline-block;margin:0 8px 8px 0;text-decoration:none;\"><img t-att-src=\"badge + 'google' + lang\" height=\"48\" alt=\"Lisa Google Walletisse\" style=\"display:block;height:48px;width:auto;max-width:100%;border:0;\"/></a>\n"
"        <a t-if=\"not card.apple_url and not card.google_url\" t-att-href=\"card.url\" style=\"display:inline-block;background:#0f172a;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;\">Ava kliendikaart</a>\n"
"    </p>\n"
"    <p style=\"color:#64748b;font-size:13px;\">Nupud kehtivad 48 tundi ja kuni kaart on sinu telefonis.</p>\n"
"    <p>Kaart uueneb ise. Kaart ja link on isiklikud, palun ära jaga neid teistega.</p>\n"
"</div>\n"
"        "

