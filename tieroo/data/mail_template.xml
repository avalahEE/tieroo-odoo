<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_wallet_card" model="mail.template">
        <field name="name">Tieroo: wallet card</field>
        <field name="model_id" ref="model_wallet_card"/>
        <field name="subject">Your loyalty card – {{ object.company_id.name }}</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div>
    <t t-set="card" t-value="object.sudo()"/>
    <p>Hello <t t-out="object.partner_id.name"/>,</p>
    <p>Add your loyalty card to your phone's wallet. Show the card at the checkout to use your customer benefits.</p>
    <p style="margin: 24px 0;">
        <t t-set="badge" t-value="card.platform_url + '/badge/'"/>
        <t t-set="lang" t-value="'.png?lang=' + (object.partner_id.lang or 'en_US')"/>
        <a t-if="card.apple_url" t-att-href="card.apple_url" style="display:inline-block;margin:0 8px 8px 0;text-decoration:none;"><img t-att-src="badge + 'apple' + lang" height="48" alt="Add to Apple Wallet" style="display:block;height:48px;width:auto;border:0;"/></a>
        <a t-if="card.google_url" t-att-href="card.google_url" style="display:inline-block;margin:0 8px 8px 0;text-decoration:none;"><img t-att-src="badge + 'google' + lang" height="48" alt="Add to Google Wallet" style="display:block;height:48px;width:auto;max-width:100%;border:0;"/></a>
        <a t-if="not card.apple_url and not card.google_url" t-att-href="card.url"
           style="display:inline-block;background:#0f172a;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;">Open loyalty card</a>
    </p>
    <p style="color:#64748b;font-size:13px;">The buttons work for 48 hours, until the card is on your phone.</p>
    <p>The card updates itself. The card and the link are personal, please do not share them.</p>
</div>
        </field>
    </record>

    <record id="mail_template_join_confirm" model="mail.template">
        <field name="name">Tieroo: confirm joining</field>
        <field name="model_id" ref="model_wallet_signup_request"/>
        <field name="subject">Confirm joining {{ object.company_id.name }}</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="lang">{{ object.lang or object.company_id.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div>
    <p>Hello <t t-out="object.name or ''"/>,</p>
    <p>Confirm your email address to join the loyalty programme of <t t-out="object.company_id.name"/>. Then add the card to your phone.</p>
    <p style="margin: 24px 0;">
        <a t-att-href="ctx.get('confirm_url')"
           style="display:inline-block;background:#111111;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none;font-weight:bold;">Confirm and get the card</a>
    </p>
    <p style="color:#64748b;font-size:13px;">The link works for 48 hours. Did not ask for this? Ignore this email: nothing happens.</p>
</div>
        </field>
    </record>
</odoo>
