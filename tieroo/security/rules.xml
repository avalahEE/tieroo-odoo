<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_access_wallet_card_user" model="ir.rule">
        <field name="name">wallet.card user</field>
        <field name="model_id" ref="model_wallet_card"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_access_wallet_card_system" model="ir.rule">
        <field name="name">wallet.card system</field>
        <field name="model_id" ref="model_wallet_card"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_access_wallet_shop_system" model="ir.rule">
        <field name="name">wallet.shop system</field>
        <field name="model_id" ref="model_wallet_shop"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
