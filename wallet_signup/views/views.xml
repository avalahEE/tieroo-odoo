<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wallet_signup" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wallet.signup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="wallet_card.res_config_settings_view_form_wallet_card"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='module_wallet_signup']" position="after">
                <div class="content-group" invisible="not module_wallet_signup">
                    <div class="row mt16">
                        <label for="wallet_signup_url" string="Join link" class="col-lg-4 o_light_label"/>
                        <field name="wallet_signup_url" widget="CopyClipboardChar" class="col-lg-8"/>
                    </div>
                    <div class="row mt8">
                        <label for="wallet_signup_tag_id" class="col-lg-4 o_light_label"/>
                        <field name="wallet_signup_tag_id" class="col-lg-8"/>
                        <div class="text-muted col-lg-12">Added to every customer who joins via the QR. Use it in Odoo Automation Rules or Marketing Automation, e.g. a welcome email or a newsletter. Empty = no tag.</div>
                    </div>
                    <div class="row mt8">
                        <label for="wallet_terms_url" class="col-lg-4 o_light_label"/>
                        <field name="wallet_terms_url" placeholder="https://" class="col-lg-8"/>
                    </div>
                    <div class="row mt8">
                        <label for="wallet_privacy_url" class="col-lg-4 o_light_label"/>
                        <field name="wallet_privacy_url" placeholder="https://" class="col-lg-8"/>
                    </div>
                    <div class="mt8">
                        <button name="action_wallet_signup_posters" type="object" string="QR code and posters" icon="oi-arrow-right" class="btn-link ps-0"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="res_partner_form_wallet_signup" model="ir.ui.view">
        <field name="name">res.partner.form.wallet.signup</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <label for="wallet_birth_day" string="Birthday" invisible="is_company"/>
                <div class="o_row" invisible="is_company">
                    <field name="wallet_birth_day" placeholder="Day" class="oe_inline" style="max-width: 4rem"/>
                    <field name="wallet_birth_month" placeholder="Month" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
